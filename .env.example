# Налаштування CXR-XAI. Скопіюйте цей файл у .env і змінюйте значення там.
# Значення нижче збігаються зі значеннями за замовчуванням у src/cxr_xai/settings.py.
# Змінні середовища мають вищий пріоритет за цей файл.

# --- Шляхи (відносні рахуються від кореня проєкту) ---
CXR_NPZ_DIR=dataverse_files
CXR_DATA_ROOT=dataset
CXR_OUTPUT_DIR=outputs
# Шаблон бази знань; cxr-xai tune записує результат у каталог запуску, а цей файл не змінює.
CXR_KB_PATH=knowledge_base.json
# Назва запуску навчання. Порожньо: train створює нову назву, інші команди беруть останній запуск.
CXR_RUN=

# --- Перевірка файлів ---
# Зображення з меншою стороною вважаються непридатними.
CXR_MIN_IMAGE_SIDE=64

# --- Виявлення дублікатів ---
# Майже-дублікати: відстань Геммінга між pHash <= порога (перевірте dataset/dedup/near_duplicate_pairs.png).
CXR_PHASH_THRESHOLD=4
# keep_one | keep_all
CXR_DEDUP_POLICY=keep_one
CXR_DROP_CONFLICTING_GROUPS=true
CXR_CHECK_MIRRORED=true

# --- Поділ на вибірки ---
CXR_SEED=42
CXR_SPLIT_RATIOS='{"train": 0.70, "val": 0.15, "test": 0.15}'

# --- Модель і навчання ---
# Зображення датасету мають розмір 224x224, тож 299 (стандартний вхід Xception) лише
# збільшує обчислення ~1.8x без нової інформації. 224 + batch 16 вміщуються в GPU з 4 ГБ
# (TensorFlow у WSL отримує лише вільну частину пам'яті); при нестачі пам'яті - batch 8.
CXR_IMG_SIZE=224
CXR_BATCH_SIZE=16
# imagenet | none (випадкові ваги, ЛИШЕ для перевірки коду)
CXR_BACKBONE_WEIGHTS=imagenet
CXR_DROPOUT=0.3

# Етап 1: навчається лише «голова», основа Xception заморожена.
CXR_STAGE1_EPOCHS=15
CXR_STAGE1_LR=0.001
# Етап 2 (fine-tuning): розморожуються блоки Xception, починаючи з вказаного.
CXR_STAGE2_EPOCHS=20
CXR_STAGE2_LR=0.00001
CXR_FINE_TUNE_FROM_BLOCK=13
# Кроків між перевірками на валідації в етапі 2. Порожньо - раз на повну епоху.
# Наприклад, 320 при batch 16 - ~4 перевірки за епоху; stage2_epochs і терпіння колбеків
# тоді рахуються в таких раундах.
CXR_STAGE2_STEPS_PER_EPOCH=

CXR_USE_CLASS_WEIGHTS=true
CXR_EARLY_STOP_PATIENCE=5
CXR_REDUCE_LR_PATIENCE=2
CXR_REDUCE_LR_FACTOR=0.2
CXR_MIN_LR=0.0000001
CXR_MIXED_PRECISION=false

# --- Аугментація (лише для train) ---
# Частка повного оберту: 0.02 * 360° ≈ ±7°.
CXR_AUG_ROTATION=0.02
CXR_AUG_ZOOM=0.10
CXR_AUG_TRANSLATION=0.05
CXR_AUG_CONTRAST=0.10

# --- Вирішувач: добір порогів T і δ за валідаційною вибіркою ---
# youden | target_accuracy
CXR_THRESHOLD_CRITERION=youden
CXR_TARGET_ACCURACY=0.95
CXR_MAX_FLAG_RATE=0.30
# Сітки пошуку: [від, до, крок]
CXR_T_GRID='[0.30, 0.99, 0.01]'
CXR_DELTA_GRID='[0.00, 0.80, 0.01]'
CXR_CONFUSION_MIN_RATE=0.03

# --- Grad-CAM ---
CXR_GRADCAM_ALPHA=0.40
CXR_BORDER_FRACTION=0.10
CXR_GRADCAM_STATS_MAX_CORRECT=200

# --- Інтерфейс ---
CXR_MAX_UPLOAD_MB=20
CXR_DISPLAY_MAX_SIDE=512
